# Shell 脚本必须用 LF。Windows 上 core.autocrlf=true 会把工作区检出成 CRLF，
# bash 读 `set -euo pipefail` 时会把 \r 当成选项名的一部分，直接报
# `set: pipefail: invalid option name`（scripts/clsi/*.sh 实际踩过）。
*.sh text eol=lf

# Reproducible engine glue and receipts are SHA-256 pinned by the runtime manifest.
frontend/public/latex-engines/swiftlatexpdftex.js text eol=lf
frontend/public/latex-engines/swiftlatexxetex.js text eol=lf
frontend/public/latex-engines/swiftlatex-build-receipt.json text eol=lf

# go mod tidy -diff compares dependency metadata byte-for-byte.
server/go.mod text eol=lf
server/go.sum text eol=lf
