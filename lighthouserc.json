{
  "ci": {
    "collect": {
      "staticDistDir": "./frontend/dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.5 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./frontend/lhci-report"
    }
  }
}
