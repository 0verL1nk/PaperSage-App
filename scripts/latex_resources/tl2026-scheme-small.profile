# Build-time TeX Live resource inventory. This is not a compile-server install.
selected_scheme scheme-small
TEXDIR /opt/papersage-texlive-2026/texlive
TEXMFSYSCONFIG /opt/papersage-texlive-2026/texmf-sysconfig
TEXMFSYSVAR /opt/papersage-texlive-2026/texmf-sysvar
TEXMFCONFIG /opt/papersage-texlive-2026/texmf-config
TEXMFVAR /opt/papersage-texlive-2026/texmf-var
TEXMFHOME /opt/papersage-texlive-2026/texmf-home
TEXMFLOCAL /opt/papersage-texlive-2026/texmf-local
option_doc 0
option_src 0
option_path 0
option_sys_bin 0
option_sys_info 0
option_sys_man 0
binary_x86_64-linux 1
