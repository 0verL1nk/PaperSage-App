# API base URL — leave empty in development (Vite proxies /api to backend)
# For production builds, set to your backend origin, e.g. https://api.example.com
# 这是「在线」环境（online）的地址；留空表示同源（前端与后端由同一个二进制提供）
VITE_API_BASE_URL=

# 「本地」环境（local）的地址。界面右上角可切换 online/local。
# 部署到 Vercel 后，local 用于把线上前端指回本机后端（默认 http://localhost:5478）
VITE_LOCAL_API_BASE_URL=

# Immutable TeX Live resource profile served by the selected API backend.
# Defaults to tl2026-swift-ef78b612-r80534-v4.
VITE_LATEX_RESOURCE_PROFILE=
