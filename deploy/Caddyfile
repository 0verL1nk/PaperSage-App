# Only enable this proxy after the Cloudflare-only ingress guard is active.
# Sanitized template: replace api.example.com with the real API host before deploying.
api.example.com {
	reverse_proxy 127.0.0.1:5478 {
		flush_interval -1
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
