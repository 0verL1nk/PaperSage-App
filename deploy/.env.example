# PaperSage Docker Compose environment overrides
# Copy to .env and fill in real values

# ── Service Ports ────────────────────────────────────────
BACKEND_PORT=5478
FRONTEND_PORT=5173
CLSI_PORT=3013
DB_PORT=5432
REDIS_PORT=6379

# ── Database ─────────────────────────────────────────────
DB_PASSWORD=papersage

# ── S3 (Cloudflare R2) ───────────────────────────────────
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=papersage
S3_REGION=auto

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
