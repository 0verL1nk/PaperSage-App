# Database
# 开发环境 (SQLite - 无需额外安装，开箱即用)
# DATABASE_URL=sqlite+aiosqlite:///./papersage.db

# 开发环境 (MySQL)
# DATABASE_URL=mysql+aiomysql://papersage:papersage_dev_password@localhost:3306/papersage

# 生产环境 (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://papersage:papersage_dev_password@localhost:5432/papersage

# Redis
REDIS_URL=redis://:papersage_dev_password@localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Email Service (Resend)
EMAIL_PROVIDER=resend
FROM_EMAIL=noreply@papersage.dev
FROM_NAME=PaperSage
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_DOMAIN=papersage.dev

# Email Service (Generic SMTP - uncomment and fill if not using Resend)
# EMAIL_PROVIDER=smtp
# FROM_EMAIL=noreply@example.com
# FROM_NAME=PaperSage
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=true

# LaTeX Service (CLSI)
LATEX_CLSI_ENABLED=false
LATEX_CLSI_BASE_URL=http://localhost:3013
LATEX_CLSI_TIMEOUT_SECONDS=120

# S3 Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=papersage
S3_REGION=us-east-1