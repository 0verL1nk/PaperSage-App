# 生产环境配置 (MySQL)
# 复制此文件为 .env 后使用: cp .env.prod .env

# Database (MySQL - 生产用)
DATABASE_URL=mysql+aiomysql://papersage:YOUR_PASSWORD_HERE@localhost:3306/papersage

# Redis (生产用，需要密码)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:6379/0

# Security (请修改为强密钥)
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=false
ALLOWED_HOSTS=your-domain.com,api.your-domain.com

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false